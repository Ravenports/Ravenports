 def check_compiler(
     configure_cache, compiler, language, target, android_version, wrapper=[]
 ):
@@ -700,9 +701,10 @@ def check_compiler(
     elif (
         target.kernel == "WASI"
         and info.type == "clang"
-        and info.version >= Version("22.1")
+        and (info.version >= Version("22.1") or platform.startswith("freebsd"))
     ):
         # The wasm32-wasi target was renamed to wasm32-wasip1 in LLVM 22.1.
+        # and FreeBSD uses it since ports 7c5b2039a45ad for all LLVM ports
         toolchain = "wasm32-wasip1"
